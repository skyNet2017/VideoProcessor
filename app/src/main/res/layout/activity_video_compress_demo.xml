<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VideoCompress Demo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchShowProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示压缩进度弹窗"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchShowCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="压缩后显示对比"
            android:checked="true"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btnRecordVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="拍摄视频"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnPickVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="选择视频（可多选）" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShowTaskList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="查看压缩任务列表" />

        <TextView
            android:id="@+id/tvQueue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="压缩队列：空闲"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#333333" />

    </LinearLayout>
</ScrollView>
